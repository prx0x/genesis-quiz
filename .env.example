# Server
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql://genesis:genesis@localhost:5432/genesis_quiz

# Session
SESSION_SECRET=change-me-to-a-long-random-secret-in-production

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# Admin bootstrap (created on first seed / migration)
# Password is hashed; set a strong password for production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password

# Allowed participant email domain (exact match)
ALLOWED_EMAIL_DOMAIN=iiitkota.ac.in
